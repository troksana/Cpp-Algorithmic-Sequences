{
  "version": 4,
  "configurePresets": [
    {
      "name": "default-debug",
      "displayName": "GCC Debug (C++17)",
      "description": "Standard configuration for Linux/macOS using GCC and C++17.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -Wall -Wextra" 
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default-debug",
      "displayName": "Build Debug",
      "configurePreset": "default-debug"
    }
  ]
}